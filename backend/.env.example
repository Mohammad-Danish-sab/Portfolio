# Set these in Render (Environment) and do not commit your real .env file.
DATABASE_URL=postgresql://user:password@host/database
ADMIN_SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=https://your-site.vercel.app
# This accepts all Vercel preview and production URLs. Replace with an exact
# regular expression for your own Vercel domain if desired.
ALLOWED_ORIGIN_REGEX=https://.*\\.vercel\\.app
